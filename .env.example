# Salin file ini menjadi .env.local untuk pengembangan lokal,
# atau isi variabel yang sama di dashboard Vercel (Project Settings > Environment Variables).

# URL koneksi Neon Postgres (wajib untuk akun, pesanan, dan katalog dinamis)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# API key Bayar.gg — HANYA di server, jangan pernah memakai awalan NEXT_PUBLIC_
BAYAR_GG_API_KEY=""

# Rahasia untuk menandatangani cookie sesi (string acak panjang)
SESSION_SECRET="ganti-dengan-string-acak-yang-panjang"

# Kredensial panel admin /admin (terpisah dari akun pembeli)
ADMIN_EMAIL="admin@raidigi.id"
ADMIN_PASSWORD="ganti-dengan-kata-sandi-admin-yang-kuat"

# URL publik aplikasi ini (dipakai untuk callback & redirect Bayar.gg)
APP_URL="http://localhost:3000"

# Opsional: webhook secret Bayar.gg untuk verifikasi tanda tangan callback
# BAYAR_GG_WEBHOOK_SECRET=""
